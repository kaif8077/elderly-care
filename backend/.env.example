MONGO_URI=mongodb_connection_string
JWT_SECRET=normal_user_jwt_secret
ALERT_HASH_SECRET=different_random_secret_for_privacy_safe_alert_hashes
ADMIN_JWT_SECRET=different_long_random_admin_session_secret
ADMIN_SESSION_HOURS=8
# Optional for local/same-origin deployments. Cross-origin HTTPS deployments
# automatically force SameSite=None and Secure cookies.
ADMIN_COOKIE_SAME_SITE=lax

# Used only by `npm run seed:admin`.
ADMIN_EMAIL=elderlycare@gmail.com
ADMIN_PASSWORD=replace_before_production
ADMIN_FORCE_PASSWORD_CHANGE=true

FRONTEND_URL=http://localhost:3000
RENDER_BACKEND_URL=https://your-backend.onrender.com
RESEND_API_KEY=resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
SYSTEM_NOTIFICATION_EMAIL=notification_recipient@example.com

# Disabled by default to keep medical profiles inside ElderlyCare.
ENABLE_EXTERNAL_AI=false
